# Copie este archivo como .env y cambie TODOS los valores marcados con "cambiar".
# Para generar secretos:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Nunca suba el archivo .env al repositorio.

ENTORNO=desarrollo

# --- Base de datos
POSTGRES_DB=votoseguro
POSTGRES_USER=votoseguro_admin
POSTGRES_PASSWORD=cambiar-clave-superusuario-bd
APP_DB_USER=votoseguro_app
APP_DB_PASSWORD=cambiar-clave-usuario-api-bd

# --- Secretos de la API (mínimo 32 caracteres cada uno)
JWT_SECRET=cambiar-este-secreto-jwt-por-uno-aleatorio-largo
CLAVE_HMAC=cambiar-esta-clave-hmac-por-una-aleatoria-larga
# OJO: si pierde esta clave no podrá descifrar el padrón guardado
CLAVE_CIFRADO_DATOS=cambiar-esta-clave-de-cifrado-por-una-larga

# --- Cuentas iniciales (se crean solo si no existen; mínimo 10 caracteres)
ADMIN_USUARIO=admin
ADMIN_PASSWORD=cambiar-Admin-2026
AUDITOR_USUARIO=auditor
AUDITOR_PASSWORD=cambiar-Auditor-2026

# true = crea una elección abierta y un padrón de prueba (UMB2026001 … UMB2026010)
SEMBRAR_DEMO=true

# --- Correo. Por defecto usa Mailpit (bandeja de pruebas en http://localhost:8025)
# Para un servidor real: SMTP_HOST=smtp.office365.com SMTP_PORT=587 SMTP_STARTTLS=true ...
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USUARIO=
SMTP_PASSWORD=

# --- Proxy / TLS
DOMINIO=localhost
PUERTO_HTTP=8080
PUERTO_HTTPS=8443
