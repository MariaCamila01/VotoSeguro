# Plantilla: la imagen oficial de nginx reemplaza ${PUERTO_HTTPS} al arrancar.

# HTTP → HTTPS
server {
    listen 80;
    server_name _;
    return 301 https://$host:${PUERTO_HTTPS}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    # TLS 1.2+ obligatorio
    ssl_certificate     /etc/nginx/certs/servidor.crt;
    ssl_certificate_key /etc/nginx/certs/servidor.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_tickets off;

    server_tokens off;
    client_max_body_size 2m;

    # Cabeceras de seguridad. La CSP no permite scripts ni estilos en línea:
    # el frontend solo carga archivos propios.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # API Gateway → contenedor de la API REST
    location /api/ {
        include /etc/nginx/conf.d/proxy_api.inc;
    }

    # Privacidad: la hora + IP de un POST /votos (o de una consulta de
    # comprobante) se podría cruzar con voto.timestamp_voto. No se registran.
    location = /api/v1/votos {
        access_log off;
        include /etc/nginx/conf.d/proxy_api.inc;
    }
    location /api/v1/ledger/comprobante/ {
        access_log off;
        include /etc/nginx/conf.d/proxy_api.inc;
    }

    # Frontend estático (cliente votante + panel de administración)
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ =404;
    }
}
